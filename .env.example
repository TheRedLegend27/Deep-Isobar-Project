# ─────────────────────────────────────────────────────────────────────────────
# Deep Isobar — environment variable template
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Kalshi API credentials ───────────────────────────────────────────────────
# Obtain from: https://kalshi.com/account/profile → API Keys

# Your Key ID (shown on the API keys page after generating a key pair)
KALSHI_API_KEY_ID=

# Path to your RSA private key PEM file (recommended)
# Example: keys/kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PATH=keys/kalshi_private_key.pem

# Alternative: paste the PEM inline with literal \n instead of newlines.
# Only used if KALSHI_PRIVATE_KEY_PATH is not set.
# Example: -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
KALSHI_PRIVATE_KEY=

# ── Polymarket (not yet implemented) ─────────────────────────────────────────
POLYMARKET_API_KEY=

# ── Discord notifications ─────────────────────────────────────────────────────
# Webhook URL for a Discord channel.  Embeds are posted after each morning run,
# settlement, and dashboard update.  Leave blank to disable notifications.
# Obtain from: Discord channel settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Dashboard server ─────────────────────────────────────────────────────────
DASHBOARD_PORT=8765
DASHBOARD_HOST=0.0.0.0

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PAPER_TRADE=true
